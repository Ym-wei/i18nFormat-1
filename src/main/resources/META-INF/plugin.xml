<idea-plugin>
    <id>com.ming.tagNavigator</id>
    <name>Tag Navigator</name>
    <vendor email="yming1554@gmail.com">Ming</vendor>

    <!-- 基础语言支持 -->
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.lang</depends>

    <depends>org.jetbrains.plugins.vue</depends>

    <extensions defaultExtensionNs="com.intellij">
        <psi.referenceContributor
                implementation="com.ming.tagNavigator.VueTagReferenceContributor"/>
    </extensions>

</idea-plugin>
